# Only files needed to build and run the application enter the Docker context.
**
!Dockerfile
!backend/requirements.txt
!backend/app/*.py
!data/my_forecast.csv
!data/routes.csv
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/public/*.webp
!frontend/public/*.png
!frontend/public/*.svg
!frontend/public/*.ico
